---
import Layout from "@/layouts/Layout.astro";
import { t, TranslationKeys } from "@/utils/i18n";

// Astro component script for 404 page
---

<Layout title={"404 - " + t(TranslationKeys.NotFound, Astro.preferredLocale)}>
  <h1>404 - {t(TranslationKeys.NotFound, Astro.preferredLocale)}</h1>
  <p>
    {t(TranslationKeys.NotFoundMessage, Astro.preferredLocale)}
    <a href="./">{t(TranslationKeys.HomePage, Astro.preferredLocale)}</a>.
  </p>
</Layout>
