---
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import { InternalError } from "@/utils/InternalError";
import { t, TranslationKeys } from "@/utils/i18n";

const error = Astro.props.error as InternalError;
---

<Layout title={`${error.code} - ${error.message}`}>
  <h1>{error.code} - {error.message}</h1>
  <p>
    {t(TranslationKeys.ReturnTo, Astro.preferredLocale)}
    <a href="./">{t(TranslationKeys.HomePage, Astro.preferredLocale)}</a> ?
  </p>
</Layout>
