---
export const prerender = false;

import { eq } from "astro:db";
import { files } from "astro:db";
import { db } from "astro:db";
import { InternalError } from "@/utils/InternalError";
import { verifyPassword } from "../utils/passwordUtils";
import Layout from "@/layouts/Layout.astro";
import FilePage from "@/components/FilePage.astro";
import { t, TranslationKeys } from "@/utils/i18n";
import normalizeKey from "@/utils/normalizeKey";
import PasswordForm from "@/components/PasswordForm.astro";

const fileId = normalizeKey(Astro.params["key"]);

let file = fileId
  ? await db.select().from(files).where(eq(files.id, fileId)).get()
  : null;

if (!file) {
  throw new InternalError(
    404,
    t(TranslationKeys.NotFound, Astro.preferredLocale),
  );
}

// Check if file has expired
const now = new Date();
if (file.expiresAt && now > file.expiresAt) {
  throw new InternalError(
    410,
    t(TranslationKeys.FileHasExpired, Astro.preferredLocale),
  );
}

let passwordConfirmed = false;
let password = "";
console.log("Checking password...");

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  password = formData.get("password")?.toString() ?? "";
}

const isPasswordValid = await verifyPassword(password, file.password);
if (isPasswordValid) {
  console.log("Password is correct.");
  passwordConfirmed = true;
}
---

<Layout
  title={!passwordConfirmed
    ? t(TranslationKeys.PasswordRequired, Astro.preferredLocale)
    : file.name}
>
    <div style="display: none;" id="file-id">{file.id}</div>
  {
    passwordConfirmed ? (
      <FilePage file={file} />
    ) : (
      <PasswordForm password={password} />
    )
  }
</Layout>

<script>
  import { addFile } from "@/utils/clientStorage";

  const fileIdEl = document.getElementById("file-id");
  if (fileIdEl) {
    const fileId = fileIdEl.textContent;
    addFile(fileId);
  }
</script>
