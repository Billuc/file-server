---
export const prerender = false;

import { eq } from "astro:db";
import { files } from "astro:db";
import { db } from "astro:db";
import { InternalError } from "@/utils/InternalError";
import { verifyPassword } from "../utils/passwordUtils";
import Layout from "@/layouts/Layout.astro";
import FilePage from "@/components/FilePage.astro";
import { t, TranslationKeys } from "@/utils/i18n";

// Astro component script
const fileId = Astro.params["key"];

let file = fileId
  ? await db.select().from(files).where(eq(files.id, fileId)).get()
  : null;

if (!file) {
  throw new InternalError(404, "File Not Found");
}

// Check if file has expired
const now = new Date();
if (file.expiresAt && now > file.expiresAt) {
  throw new InternalError(410, "File has expired");
}

let passwordConfirmed = false;
let password = "";
console.log("Checking password...");

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  password = formData.get("password")?.toString() ?? "";
}

const isPasswordValid = await verifyPassword(password, file.password);
if (isPasswordValid) {
  console.log("Password is correct.");
  passwordConfirmed = true;
}
---

<Layout
  title={!passwordConfirmed
    ? t(TranslationKeys.PasswordRequired, Astro.preferredLocale)
    : file.name}
>
  {
    passwordConfirmed ? (
      <FilePage file={file} />
    ) : (
      <form method="POST" class="password-form">
        <h2>
          {t(TranslationKeys.FileIsPasswordProtected, Astro.preferredLocale)}
        </h2>

        {password !== "" && (
          <div style="color: red;">
            {t(TranslationKeys.IncorrectPassword, Astro.preferredLocale)}
          </div>
        )}

        <input
          type="password"
          name="password"
          placeholder={t(
            TranslationKeys.PasswordPlaceholder,
            Astro.preferredLocale,
          )}
          required
        />

        <button type="submit">
          {t(TranslationKeys.Unlock, Astro.preferredLocale)}
        </button>
      </form>
    )
  }
</Layout>
