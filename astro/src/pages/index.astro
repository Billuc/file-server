---
import SearchBar from "@/components/SearchBar.astro";
import Layout from "@/layouts/Layout.astro";
import UploadForm from "@/components/UploadForm.astro";
import { t, TranslationKeys } from "@/utils/i18n";
---

<Layout title={t(TranslationKeys.AppName, Astro.preferredLocale)}>
  <h1 class="home-title">
    {t(TranslationKeys.AppName, Astro.preferredLocale)} - {
      t(TranslationKeys.AppDescription, Astro.preferredLocale)
    }
  </h1>
  <SearchBar />
  <UploadForm />
</Layout>
