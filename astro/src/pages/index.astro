---
import SearchBar from "@/components/SearchBar.astro";
import Layout from "@/layouts/Layout.astro";
import UploadForm from "@/components/UploadForm.astro";
import { t, TranslationKeys } from "@/utils/i18n";
import YourFiles from "@/components/YourFiles.astro";
import MonoHeader from "@/components/MonoHeader.astro";
---

<Layout title={t(TranslationKeys.AppName, Astro.preferredLocale)}>
    <MonoHeader
        title={t(TranslationKeys.AppName, Astro.preferredLocale)}
        subtitle={t(TranslationKeys.AppDescription, Astro.preferredLocale)}
    />
    <p style="margin-block: 2rem;">
        {t(TranslationKeys.HomepageMessage, Astro.preferredLocale)}
    </p>

    <SearchBar />
    <hr/>
    <UploadForm />
    <hr/>
    <YourFiles />
</Layout>
