---
import { TranslationKeys, t } from "@/utils/i18n";
import MonoInput from "./MonoInput.astro";

const { password } = Astro.props;
---

<form method="POST">
    <h1>
        {t(TranslationKeys.FileIsPasswordProtected, Astro.preferredLocale)}
    </h1>

    {password !== "" && (
        <div style="color: red;">
            {t(TranslationKeys.IncorrectPassword, Astro.preferredLocale)}
        </div>
    )}

    <MonoInput
        label="Password"
        type="password"
        name="password"
        placeholder={t(
          TranslationKeys.PasswordPlaceholder,
          Astro.preferredLocale,
        )}
        required
        style="margin-top: 1rem;"
    /><br/>

    <button type="submit">
        {t(TranslationKeys.Unlock, Astro.preferredLocale)}
    </button>
</form>
