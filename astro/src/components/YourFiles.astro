---
import { t, TranslationKeys } from "@/utils/i18n";
---

<section>
  <h4>Your files</h4>

  <table id="your-files">
    <thead>
      <tr>
        <th>Status</th>
        <th>Link</th>
        <th>Expires</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
    </tbody>
  </table>

  <template id="file-row">
    <tr>
      <td class="file-status"></td>
      <td class="file-link"><a></a></td>
      <td class="file-expires"></td>
      <td>
        <button class="error">{t(
          TranslationKeys.Remove,
          Astro.preferredLocale,
          )}</button>
      </td>
    </tr>
  </template>
</section>

<script>
  import { getFiles, removeFile } from "@/utils/clientStorage";

  const files = getFiles();
  const yourFilesContainer = document.querySelector("#your-files tbody");
  const fileTemplate = document.getElementById("file-row");

  for (const [k, expires] of files) {
    const rowFragment = document.importNode(fileTemplate.content, true);
    {
      const status = rowFragment.querySelector(".file-status")
      if (expires > new Date()) {
        status.textContent = "[ OK ]";
        status.classList.add("ok");
      } else {
        status.textContent = "[EXPD]";
        status.classList.add("expired");
      }
    }
    {
      const link = rowFragment.querySelector(".file-link a");
      link.href = `./${k}`;
      link.textContent = k;
    }
    {
      rowFragment.querySelector(".file-expires").textContent = expires.toLocaleDateString(undefined, {
        month: "short",
        day: "numeric",
      });
    }
    yourFilesContainer?.append(rowFragment);
  }
</script>

<style>
  #your-files {
    margin-bottom: 1rem;
  }

  .file-status.ok {
    color: var(--success);
  }
  .file-status.expired {
    color: var(--error);
  }
</style>
