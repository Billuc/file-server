---
import { t, TranslationKeys } from "@/utils/i18n";
---

<div class="upload-section">
  <form action="./upload" method="POST" enctype="multipart/form-data">
    <div class="upload-options">
      <div class="file-input">
        <h4>{t(TranslationKeys.SelectFile, Astro.preferredLocale)}...</h4>
        <input
          type="file"
          name="file"
          data-errormessage={t(
            TranslationKeys.FileIsTooLarge,
            Astro.preferredLocale,
          )}
        />
      </div>

      <div class="text-input">
        <h4>...{t(TranslationKeys.EnterText, Astro.preferredLocale)}:</h4>
        <textarea
          name="text"
          placeholder={t(
            TranslationKeys.EnterTextPlaceholder,
            Astro.preferredLocale,
          )}
          rows="6"></textarea>

        <label>
          {t(TranslationKeys.Filename, Astro.preferredLocale)}:
          <input
            type="text"
            name="filename"
            placeholder={t(
              TranslationKeys.FilenamePlaceholder,
              Astro.preferredLocale,
            )}
          />
        </label>
      </div>
    </div>

    <div style="margin-bottom: 15px;">
      <label>
        {t(TranslationKeys.Password, Astro.preferredLocale)} ({
          t(TranslationKeys.Optional, Astro.preferredLocale)
        }):
        <input
          type="password"
          name="password"
          placeholder={t(
            TranslationKeys.FilenamePlaceholder,
            Astro.preferredLocale,
          )}
        />
      </label>
    </div>

    <button type="submit" class="upload-button">
      {t(TranslationKeys.Upload, Astro.preferredLocale)}
    </button>
  </form>
</div>

<script>
  const fileInput: HTMLInputElement | null =
    document.querySelector(".file-input input");

  fileInput?.addEventListener("change", () => {
    fileInput.setCustomValidity("");
    const files = fileInput.files;
    if (!files) return;
    for (const file of files) {
      if (file.size > 10 * 1024 * 1024) {
        const errorMessage =
          fileInput.dataset.errormessage ??
          "Le fichier XXX est trop volumineux.";
        fileInput.setCustomValidity(
          errorMessage.replace("XXX", file.name) + " (>10MB)",
        );
        fileInput.reportValidity();
        return;
      }
    }
  });
</script>
