---
import { t, TranslationKeys } from "@/utils/i18n";
import MonoInput from "./MonoInput.astro";
import MonoTextarea from "./MonoTextarea.astro";
---

<section>
    <form action="./upload" method="POST" enctype="multipart/form-data">
        <h4>{t(TranslationKeys.SelectFile, Astro.preferredLocale)}...</h4>
        <div class="card">
            <label>
              <span>Choose a file</span>
              <input
                  type="file"
                  name="file"
                  data-errormessage={t(
                  TranslationKeys.FileIsTooLarge,
                  Astro.preferredLocale,
                  )}
              />
            </label>
            <div style="display: flex; flex-direction: column; align-items: center; margin-left: 1ch;">
              <MonoInput
                  label={
                      t(TranslationKeys.Password, Astro.preferredLocale) + " (" +
                      t(TranslationKeys.Optional, Astro.preferredLocale) + ")"
                  }
                  type="password"
                  name="password"
                  placeholder={t(
                      TranslationKeys.PasswordPlaceholder,
                      Astro.preferredLocale,
                  )}
              />
              <button type="submit">
                  {t(TranslationKeys.Upload, Astro.preferredLocale)}
              </button>
            </div>
        </div>
    </form>
    <form action="./upload" method="POST" enctype="multipart/form-data">
        <h4>...{t(TranslationKeys.EnterText, Astro.preferredLocale)}:</h4>
        <MonoTextarea
            label="Type some text to upload"
            name="text"
            placeholder={t(
                TranslationKeys.EnterTextPlaceholder,
                Astro.preferredLocale,
            )}
            rows="6"
        />
        <div style="display: flex; flex-flow: row wrap; gap: 1ch; align-items: center;">
            <MonoInput
                label={t(TranslationKeys.Filename, Astro.preferredLocale)}
                type="text"
                name="filename"
                placeholder={t(
                TranslationKeys.FilenamePlaceholder,
                Astro.preferredLocale,
                )}
            />
            <MonoInput
                label={
                t(TranslationKeys.Password, Astro.preferredLocale) + " (" +
                t(TranslationKeys.Optional, Astro.preferredLocale) + ")"
                }
                type="password"
                name="password"
                placeholder={t(
                TranslationKeys.PasswordPlaceholder,
                Astro.preferredLocale,
                )}
            />
        </div>

        <button type="submit" style="display: block; margin-left: auto;">
            {t(TranslationKeys.Upload, Astro.preferredLocale)}
        </button>
    </form>
</section>

<script>
  const fileInput: HTMLInputElement | null =
    document.querySelector("input[type=\"file\"]");

  fileInput?.addEventListener("change", () => {
    fileInput.setCustomValidity("");
    const files = fileInput.files;
    if (!files) return;
    for (const file of files) {
      if (file.size > 10 * 1024 * 1024) {
        const errorMessage =
          fileInput.dataset.errormessage ??
          "Le fichier XXX est trop volumineux.";
        fileInput.setCustomValidity(
          errorMessage.replace("XXX", file.name) + " (>10MB)",
        );
        fileInput.reportValidity();
        return;
      }
    }
  });
</script>

<style>
  button {
    margin-top: 1rem;
  }
</style>
