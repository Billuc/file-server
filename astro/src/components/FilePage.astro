---
import { getFileType } from "@/utils/fileUtils";
import { nullPassword } from "@/utils/passwordUtils";
import FileContent from "./FileContent.astro";
import { t, TranslationKeys } from "@/utils/i18n";
import MonoHeader from "./MonoHeader.astro";
import { renderSVG } from "uqr";

interface Props {
  file: {
    id: string;
    name: string;
    password: string;
  };
}

const { file } = Astro.props;

const fileType = getFileType(file.name);
const unicodeQR = renderSVG(Astro.url.href);
---

<MonoHeader title={file.name} subtitle={file.id} />

<section style="margin-block: 1rem;">
    {
      fileType === "text" && (
        <button
          id="copy-button"
          data-success={t(
            TranslationKeys.ContentCopiedToClipboard,
            Astro.preferredLocale,
          )}
        >
          {t(TranslationKeys.CopyContent, Astro.preferredLocale)}
        </button>
      )
    }
    <a
      href={`./f/${encodeURIComponent(file.id)}?enc=${encodeURIComponent(
        file.password,
      )}`}
      download={file.name}
    >{
      t(TranslationKeys.Download, Astro.preferredLocale)
    }</a>
    <button
      id="share-button"
      data-success={t(
        TranslationKeys.UrlCopiedToClipboard,
        Astro.preferredLocale,
      )}>{t(TranslationKeys.CopyURL, Astro.preferredLocale)}</button
    >
    <button
      id="show-qr-button"
      >{t(TranslationKeys.ShowQR, Astro.preferredLocale)}</button
    >
    <div id="qrcode" style="display: none; line-height: 1rem;" set:html={unicodeQR}>
</section>

<FileContent file={file} fileType={fileType} />

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const copyButton = document.getElementById("copy-button")!;
    const shareButton = document.getElementById("share-button")!;
    const showQRButton = document.getElementById("show-qr-button")!;
    const qrcodeDiv = document.getElementById("qrcode")!;
    const fileContent = document.getElementById("file-content")!;

    if (copyButton) {
      const copyContent = () => {
        navigator.clipboard.writeText(fileContent.textContent).then(() => {
          alert(copyButton.dataset.success || "Copié");
        });
      };
      copyButton.addEventListener("click", copyContent);
    }

    const shareContent = () => {
      navigator.clipboard.writeText(window.location.href).then(() => {
        alert(shareButton.dataset.success || "Copié");
      });
    };
    shareButton.addEventListener("click", shareContent);

    const toggleQR = () => {
      qrcodeDiv.style.display = qrcodeDiv.style.display === "none" ? "block" : "none";
    }
    showQRButton.addEventListener("click", toggleQR);
  });
</script>
