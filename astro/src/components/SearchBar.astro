---
import { t, TranslationKeys } from "@/utils/i18n";
---

<form class="search-bar">
  <input
    id="key"
    name="key"
    type="text"
    placeholder="e.g., a-b-c-d"
    required
    class="search-bar-input"
    data-error={t(TranslationKeys.InvalidKeyFormat, Astro.preferredLocale)}
  />
  <button type="submit" class="search-bar-button"
    >{t(TranslationKeys.Search, Astro.preferredLocale)}</button
  >
</form>

<script>
  function onFileSearch(event: Event) {
    event.preventDefault();
    const form = event.target as HTMLFormElement;
    const input = form.elements.namedItem("key") as HTMLInputElement;
    const key = input.value.trim();

    // Redirect to the file page with the provided key
    window.location.href = `./${encodeURIComponent(key)}`;
  }

  document
    .querySelectorAll(".search-bar")
    .forEach((el) => el.addEventListener("submit", onFileSearch));
</script>
